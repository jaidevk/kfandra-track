# ─── Supabase ────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
#
# LOCAL DEV:   run `npx supabase start` and use the values it prints.
# HOSTED/PROD: Supabase Dashboard → Project Settings → API.

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon key — safe to expose to the browser (RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — SERVER ONLY, bypasses RLS. NEVER expose to the browser
# or commit a real value. Used for custom phone+PIN auth.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
